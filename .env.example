# 复制本文件为 .env 后填写（.env 不会被 git 跟踪）

# ===== 安全密钥（务必改成一段随机字符串）=====
SECRET_KEY=请替换为随机字符串
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== AI 大模型（OpenAI 兼容协议，任选一家）=====
# 详细接入步骤见网页右上角「接入教程」按钮。
#
# 【DeepSeek（推荐）】
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-your-api-key
#
# 【阿里云百炼 / 通义】
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-your-api-key
#
# 【本地 Ollama（免费）】
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5
# LLM_API_KEY=ollama

# ===== 数据库 =====
# 默认 SQLite，开箱即用、无需安装。数据保存在项目根目录 app.db 文件。
SQLALCHEMY_DATABASE_URL=sqlite:///./app.db
# 如需 MySQL，改用下面这行（并安装 pymysql）：
# SQLALCHEMY_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_youliao

# ===== 未登录用户聊天限流：每个 IP 每天最多免费体验多少次（跨自然日自动重置）=====
ANONYMOUS_RATE_LIMIT_MAX=10
